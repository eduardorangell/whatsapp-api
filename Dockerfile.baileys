FROM denoland/deno:2.9.5

WORKDIR /app

# Imagem leve: Baileys usa WebSocket puro + Signal nativo, sem navegador
COPY deno.json deno.lock ./
RUN deno install

COPY src/ ./src/

ENV WA_ENGINE=baileys
ENV KV_PATH=/data/kv.sqlite3
ENV PASTA_ARQUIVOS=/arquivos
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["deno", "eval", \
    "const r = await fetch('http://localhost:3000/status'); Deno.exit(r.ok ? 0 : 1)"]

CMD ["run", \
  "--allow-net", \
  "--allow-env", \
  "--allow-read", \
  "--allow-sys", \
  "--allow-ffi", \
  "--allow-write=/data,/tmp", \
  "--unstable-kv", \
  "--unstable-otel", \
  "src/server.ts"]
