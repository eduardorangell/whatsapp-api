{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-sys --unstable-kv --watch server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-sys --unstable-kv server.ts",
    "check": "deno fmt --check --ignore=node_modules && deno lint --ignore=node_modules && deno check server.ts wa_test.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-sys --unstable-kv"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "baileys": "npm:baileys@7.0.0-rc14",
    "qrcode-terminal": "npm:qrcode-terminal@^0.12.0",
    "@std/encoding": "jsr:@std/encoding@^1"
  },
  "nodeModulesDir": "auto"
}
