{
  "title": "Whatsapp API",
  "description": "Whatsapp API is a Deno-based implementation of the WPPConnect library.",
  "license": "MIT",
  "tasks": {
    "start": "deno run --watch src/server.ts",
    "dev": "deno run --watch -A src/server.ts",
    "check": "deno fmt --check --ignore=node_modules && deno lint --ignore=node_modules && deno check **/*.ts ",
    "docker:build": "docker build -t wpp-api .",
    "docker:save": "docker save -o wpp-api.tar wpp-api"
  },
  "imports": {
    "@deno-library/logger": "jsr:@deno-library/logger@^1.2.0",
    "@hono": "jsr:@hono/hono@^4.7.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.8",
    "@wppconnect-team/wppconnect": "npm:@wppconnect-team/wppconnect@^1.37.2",
    "zod": "npm:zod@^3.25.67"
  },
  "nodeModulesDir": "auto"
}
