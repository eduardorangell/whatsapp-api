{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-sys --unstable-kv --watch src/server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-sys --unstable-kv src/server.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-sys --unstable-kv",
    "check": "deno fmt --check --ignore=node_modules && deno lint --ignore=node_modules && deno check src/*.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "baileys": "npm:baileys@7.0.0-rc14",
    "qrcode-terminal": "npm:qrcode-terminal@^0.12.0",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/media-types": "jsr:@std/media-types@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "nodeModulesDir": "auto"
}
