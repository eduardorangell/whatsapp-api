{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi --unstable-kv --unstable-otel --watch src/server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi --unstable-kv --unstable-otel src/server.ts",
    "test": "DENO_ENV=test deno test --allow-net --allow-env --allow-read --allow-sys --unstable-kv",
    "check": "deno fmt --check --ignore=node_modules && deno lint --ignore=node_modules && deno check src/*.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "logs": "docker compose logs -f"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "baileys": "npm:baileys@7.0.0-rc14",
    "qrcode-terminal": "npm:qrcode-terminal@^0.12.0",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/media-types": "jsr:@std/media-types@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:baileys@7.0.0-rc14", "npm:protobufjs@7.6.5"]
}
